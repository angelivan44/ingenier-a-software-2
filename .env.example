# Cadena de conexión a Postgres. Sin ella, los enlaces se guardan en memoria.
DATABASE_URL=postgres://usuario:clave@localhost:5432/acortador

# Base de pruebas. Nunca uses aquí la de producción.
TEST_DATABASE_URL=postgres://usuario:clave@localhost:5432/acortador_test

# Puerto del servidor. Por defecto es 3000.
PORT=3000
